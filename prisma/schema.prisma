generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ORDER_STATUS
  REVIEW
  PRODUCT_UPDATE
  SYSTEM
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  name       String?  @db.VarChar(100)
  avatar_url String?  @db.Text
  phone      String?  @db.VarChar(20)
  roles      Role[]   @default([CUSTOMER])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  products      Product[]
  orders        Order[]
  reviews       Review[]
  vendorProfile VendorProfile?
  notifications Notification[]

  @@map("users")
}

model VendorProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName   String?  @db.VarChar(200)
  description    String?  @db.Text
  whatsappNumber String   @db.VarChar(20)
  address        String?  @db.Text
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("vendor_profiles")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.Text
  price       Float    
  isFeatured  Boolean  @default(false)
  isArchived  Boolean  @default(false)
  stock       Int      @default(0)
  images      Image[]
  orderItems  OrderItem[]
  reviews     Review[]
  whatsappLink   String?
  localisation Json? 

  // Relations
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String   @db.Uuid
  color      Color    @relation(fields: [colorId], references: [id])
  colorId    String   @db.Uuid
  size       Size     @relation(fields: [sizeId], references: [id])
  sizeId     String   @db.Uuid
  
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([categoryId])
  @@map("products")
}

model Color {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(100)
  color     String    @unique @db.VarChar(10)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("colors")
}

model Size {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(100)
  value     String    @unique @db.VarChar(10)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("sizes")
}

model Image {
  id        String   @id @default(uuid()) @db.Uuid
  url       String   @db.Text
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("images")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(100)
  billboard String    @db.Text
  title     String    @db.VarChar(50)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  amount     Float    
  total      Int
  isPaid     Boolean     @default(false)
  orderItems OrderItem[]
  delivery   Delivery?
  userId     String      @db.Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  amount    Float    
  total     Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Delivery {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @unique @db.Uuid
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status       DeliveryStatus @default(PENDING)
  deliveryDate DateTime?
  address      String         @db.Text
  city         String         @db.VarChar(100)
  postalCode   String         @db.VarChar(20)
  country      String         @db.VarChar(100)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("deliveries")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?  @db.Text
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([productId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  content   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false)
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}


















